{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TAMGA",
  "mainBinaryName": "tamga",
  "version": "0.1.0",
  "identifier": "io.github.davidharputoglu.tamga",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TAMGA",
        "width": 1000,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "publisher": "David HARPUTOGLU",
    "copyright": "Copyright (c) 2026 TAMGA - David HARPUTOGLU",
    "license": "MIT",
    "shortDescription": "Convertisseur de paquets Linux (.deb, .rpm, Arch, .sh)",
    "longDescription": "TAMGA convertit les paquets Linux d'un format à l'autre (.deb, .rpm, paquets Arch .pkg.tar.zst et installateurs .sh) et traduit leurs dépendances pour chaque distribution.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "admin"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
